{
  "name": "@tracegate/solari",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/**/*.test.js",
    "smoke": "pnpm run build && node probes/public-site-safety-smoke.mjs"
  },
  "dependencies": {
    "@solarisdk/browser": "0.1.2",
    "@tracegate/shared": "workspace:*",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
