    "@solarisdk/browser": "0.1.2",
    "@solarisdk/sdk": "0.1.2",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
